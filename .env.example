# Every variable is optional. Copy this file to .env and set what you need.
# VITE_ variables are compiled into the page at build time.

# Site
VITE_SITE_NAME=Census
VITE_OWNER_NAME=                     # footer copyright and closing contact button; empty hides the copyright
VITE_LOGO_URL=                       # optional logo next to the name, served from your own domain
VITE_OG_IMAGE_URL=                   # optional social preview image
VITE_COOKIE_PREFIX=census            # cookie census_anon_id, storage keys census_profile, census_consent
VITE_DEFAULT_LANG=en                 # en | es, for browsers set to neither

# Optional closing section (09). Hidden unless VITE_CLOSING_ENABLED=true.
# Body: one paragraph per line (a literal \n also counts), **bold** allowed.
# Spanish values fall back to English.
VITE_CLOSING_ENABLED=false
VITE_CLOSING_TITLE_EN=
VITE_CLOSING_BODY_EN=
VITE_CLOSING_TITLE_ES=
VITE_CLOSING_BODY_ES=

# Links. Each one is hidden while empty.
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=
VITE_EXTRA_LINK_LABEL=               # e.g. a link to another demo
VITE_EXTRA_LINK_LABEL_ES=            # falls back to VITE_EXTRA_LINK_LABEL
VITE_EXTRA_LINK_URL=
VITE_REPO_URL=https://github.com/jcgaal/census

# Server
GEO_PROVIDER_URL=                    # optional IP lookup, {ip} placeholder, e.g. https://ipapi.co/{ip}/json/
PORT=3001
